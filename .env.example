# Generated automatically with random secrets by Chay_Docker.bat on first run.
POSTGRES_PASSWORD=replace_with_random_password
JWT_SECRET=replace_with_random_secret_at_least_64_characters
JWT_REFRESH_SECRET=replace_with_another_random_secret_at_least_64_characters
DEVICE_TOKEN=your_secure_device_token_123
WEB_PORT=3000
AUDIO_PORT=8765
WHISPER_MODEL_SIZE=medium
WHISPER_DEVICE=auto
ASR_MODE=local
REASONING_MODE=rules
CREATE_CENSORED_AUDIO=false
# Optional; leave empty to use local Whisper.
GROQ_API_KEY=
